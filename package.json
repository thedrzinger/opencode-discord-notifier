{
  "name": "opencode-discord-notifier",
  "version": "2.0.1",
  "description": "OpenCode plugin that sends Discord notifications for pending permissions, questions, and idle sessions, with buttons to answer permissions directly from Discord.",
  "type": "module",
  "main": "dist/plugin.js",
  "types": "dist/plugin.d.ts",
  "oc-plugin": [
    "server"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thedrzinger/opencode-discord-notifier.git"
  },
  "homepage": "https://github.com/thedrzinger/opencode-discord-notifier#readme",
  "bugs": {
    "url": "https://github.com/thedrzinger/opencode-discord-notifier/issues"
  },
  "files": [
    "dist",
    "config.example.json"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "discord",
    "discord-bot",
    "notifications",
    "cli"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.3",
    "discord.js": "^14.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "license": "MIT"
}
